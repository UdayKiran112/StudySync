# StudySync production Caddyfile
# Installed to C:\ProgramData\StudySync\app\caddy\Caddyfile
# Serves the built React frontend and proxies /api/* to the FastAPI backend.

# Caddy binds to all interfaces so LAN clients can reach the app at
# http://<this-machine-IP>. Port 80 means no port numbers to remember.

:80 {
	# ---- ZKTeco device push traffic (see below) ----
	# The ADMS device speaks a plain-text protocol. Response compression
	# (zstd/gzip) or caching headers would confuse older firmware and break
	# the handshake, so /iclock/* is explicitly EXCLUDED from compression
	# and told never to cache. See the /iclock/* handler below.
	@biometric path /iclock/*
	@not-biometric not path /iclock/*
	encode @not-biometric zstd gzip

	# ---- Static frontend root ----
	root * C:\ProgramData\StudySync\app\frontend

	# ---- API traffic goes to FastAPI (matched first, never hit the SPA) ----
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# ---- ZKTeco ADMS device push protocol (device -> server) ----
	# The MB360 connects OUT to this machine and POSTs attendance to
	# /iclock/* (no auth, plain-text protocol). Without this block the
	# device's handshake/push would fall through to the SPA below and it
	# would never register. Port 80 is already firewalled open for the LAN,
	# so point the device's Comm > Cloud Server Setting at this machine's
	# LAN IP on port 80.
	handle @biometric {
		# No compression (see matcher above) and never cached, so a stale
		# copy can never be served back to the device on the next push.
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8000
	}

	# ---- Content-addressed build assets: cache forever ----
	# Vite emits hashed filenames (index-<hash>.js), so these are immutable.
	handle /assets/* {
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# ---- Everything else: React SPA with history-API fallback ----
	# Deep links like /students/42 return index.html so client-side routing works.
	# index.html itself is never cached so a new deploy is picked up immediately.
	handle {
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}

	# ---- Security headers ----
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
	}

	# ---- Logging ----
	log {
		output file C:\ProgramData\StudySync\logs\caddy\access.log
		format json
		level INFO
	}
}
