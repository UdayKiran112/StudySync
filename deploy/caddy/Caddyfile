# StudySync production Caddyfile
# Installed to C:\ProgramData\StudySync\app\caddy\Caddyfile
# Serves the built React frontend and proxies /api/* to the FastAPI backend.

# Caddy binds to all interfaces so LAN clients can reach the app at
# http://<this-machine-IP>. Port 80 means no port numbers to remember.

:80 {
	# Response compression (zstd/gzip) for everything; there is no
	# plain-text device-push protocol left to protect from it.
	encode zstd gzip

	# ---- Static frontend root ----
	root * C:\ProgramData\StudySync\app\frontend

	# ---- API traffic goes to FastAPI (matched first, never hit the SPA) ----
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# ---- Content-addressed build assets: cache forever ----
	# Vite emits hashed filenames (index-<hash>.js), so these are immutable.
	handle /assets/* {
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# ---- Everything else: React SPA with history-API fallback ----
	# Deep links like /students/42 return index.html so client-side routing works.
	# index.html itself is never cached so a new deploy is picked up immediately.
	handle {
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}

	# ---- Security headers ----
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
	}

	# ---- Logging ----
	log {
		output file C:\ProgramData\StudySync\logs\caddy\access.log
		format json
		level INFO
	}
}
